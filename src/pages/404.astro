---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Pagina non trovata | ASD Harmonie Pilates & Wellness"
  description="La pagina richiesta non è disponibile."
  noindex={true}
>
  <section class="not-found section">
    <div class="container not-found-inner">
      <p class="eyebrow">Errore 404</p>
      <h1>Questa pagina non è qui.</h1>
      <p>Puoi tornare alla pagina principale e trovare informazioni, orari e contatti di Harmonie.</p>
      <a class="button button--primary" href="/">Torna alla home <Icon name="arrow" /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 65vh;
    display: grid;
    align-items: center;
  }

  .not-found-inner {
    max-width: 50rem;
    text-align: center;
  }

  .not-found-inner .eyebrow {
    justify-content: center;
  }

  h1 {
    margin-bottom: var(--space-4);
  }

  p:not(.eyebrow) {
    max-width: 37rem;
    margin: 0 auto var(--space-5);
    font-size: var(--step-1);
  }
</style>
