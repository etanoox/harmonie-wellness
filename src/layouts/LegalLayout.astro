---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={`${title} | ASD Harmonie Pilates & Wellness`} description={description}>
  <article class="legal section">
    <div class="container legal-wrap">
      <p class="eyebrow">Informazioni legali</p>
      <h1>{title}</h1>
      <p class="updated">Ultimo aggiornamento: {updated}</p>
      <div class="legal-content"><slot /></div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal-wrap {
    max-width: 52rem;
  }

  h1 {
    margin-bottom: 0.75rem;
    font-size: var(--step-4);
  }

  .updated {
    margin-bottom: var(--space-6);
    font-size: var(--step--1);
  }

  .legal-content :global(h2) {
    margin: var(--space-6) 0 var(--space-3);
    font-size: var(--step-2);
  }

  .legal-content :global(p),
  .legal-content :global(li) {
    max-width: 46rem;
  }
</style>
