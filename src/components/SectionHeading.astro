---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  headingId?: string;
}

const { eyebrow, title, intro, align = 'left', headingId } = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={headingId}>{title}</h2>
  {intro && <p class="section-heading__intro">{intro}</p>}
</header>

<style>
  .section-heading {
    max-width: 45rem;
    margin-bottom: var(--space-6);
  }

  .section-heading--center {
    margin-inline: auto;
    text-align: center;
  }

  .section-heading--center .eyebrow {
    justify-content: center;
  }

  h2 {
    margin-bottom: var(--space-4);
  }

  .section-heading__intro {
    max-width: 39rem;
    margin-bottom: 0;
    font-size: var(--step-1);
  }

  .section-heading--center .section-heading__intro {
    margin-inline: auto;
  }
</style>
