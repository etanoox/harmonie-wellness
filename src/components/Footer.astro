---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import logo from '../assets/images/harmoniewellness-logo.webp';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <a class="footer-brand" href="/" aria-label={`${site.name} — Home`}>
      <Image src={logo} alt="Logo ASD Harmonie Pilates & Wellness" width={132} height={132} loading="lazy" decoding="async" />
      <span>{site.name}</span>
    </a>

    <div class="footer-column">
      <h2>Contatti</h2>
      <a href={site.contact.phoneHref}>{site.contact.phoneDisplay}</a>
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
    </div>

    <div class="footer-column">
      <h2>Studio</h2>
      <p>{site.address.street}<br />{site.address.postalCode} {site.address.locality} ({site.address.province})</p>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {site.name}</p>
    <nav aria-label="Informazioni legali">
      <a href="/privacy/">Privacy</a>
      <a href="/cookie-policy/">Cookie Policy</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-7) calc(var(--space-7) + 4.5rem);
    border-top: 1px solid var(--color-border);
    background: var(--color-sage-100);
  }

  .footer-main {
    display: grid;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .footer-brand {
    display: grid;
    max-width: 15rem;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
  }

  .footer-brand :global(img) {
    width: 6.5rem;
    height: 6.5rem;
    object-fit: cover;
  }

  .footer-column {
    display: grid;
    align-content: start;
    gap: 0.45rem;
  }

  .footer-column h2 {
    margin-bottom: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-column p,
  .footer-column a {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.93rem;
  }

  .footer-column a {
    width: fit-content;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.82rem;
  }

  .footer-bottom nav {
    display: flex;
    gap: 1.2rem;
  }

  .footer-bottom a {
    font-size: 0.82rem;
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .site-footer {
      padding-bottom: var(--space-6);
    }

    .footer-main {
      grid-template-columns: 1.2fr 0.8fr 0.8fr;
    }
  }
</style>
