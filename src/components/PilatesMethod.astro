---
import { Picture } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import methodImage from '../assets/images/studio-agira.webp';

const principles = [
  { title: 'Forza e controllo', text: 'Movimenti precisi e progressivi che coinvolgono il centro del corpo.' },
  { title: 'Flessibilità ed equilibrio', text: 'Una pratica orientata a mobilità, coordinazione e stabilità.' },
  { title: 'Respiro e postura', text: 'Respirazione, allineamento e attenzione accompagnano ogni esercizio.' },
  { title: 'Consapevolezza', text: 'Il movimento diventa un’occasione per ascoltare il corpo e restare presenti.' },
] as const;
---

<section id="metodo" class="section section--sage method" aria-labelledby="method-title">
  <div class="container">
    <div class="method-head">
      <SectionHeading
        eyebrow="Il metodo Pilates"
        title="Controllo, respiro e movimento consapevole."
        intro="Il Pilates unisce esercizio fisico e concentrazione. La pratica lavora in modo armonico su forza, flessibilità, equilibrio, postura e coordinazione, rispettando qualità e controllo del gesto."
        headingId="method-title"
      />
      <p class="method-history">
        Sviluppato da Joseph Hubertus Pilates e inizialmente chiamato <em>Contrology</em>, il metodo mette al centro
        il controllo del corpo, la respirazione e la fluidità del movimento.
      </p>
    </div>

    <div class="method-grid">
      <div class="method-image">
        <Picture
          src={methodImage}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[420, 600]}
          sizes="(max-width: 767px) calc(100vw - 2rem), 39vw"
          alt="Partecipanti a una lezione di Pilates all’aperto con tappetini e piccoli attrezzi"
          loading="lazy"
          decoding="async"
        />
      </div>
      <ul class="principles" aria-label="Principi della pratica">
        {principles.map((principle, index) => (
          <li class="principle">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .method-head {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .method-head :global(.section-heading) {
    margin-bottom: 0;
  }

  .method-history {
    max-width: 31rem;
    padding: var(--space-4);
    border: 1px solid var(--color-sage-300);
    margin: 0;
    background: rgba(255, 255, 255, 0.45);
    border-radius: var(--radius-md);
  }

  .method-grid {
    display: grid;
    gap: var(--space-5);
  }

  .method-image {
    overflow: hidden;
    min-height: 27rem;
    border-radius: var(--radius-lg);
  }

  .method-image :global(picture),
  .method-image :global(img) {
    width: 100%;
    height: 100%;
  }

  .method-image :global(img) {
    object-fit: cover;
  }

  .principles {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .principle {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: var(--space-4);
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-sage-300);
  }

  .principle > span {
    color: var(--color-sage-700);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
  }

  .principle h3 {
    margin-bottom: 0.4rem;
    font-size: var(--step-2);
  }

  .principle p {
    margin: 0;
  }

  @media (min-width: 50rem) {
    .method-head {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.55fr);
      align-items: end;
    }

    .method-history {
      justify-self: end;
    }

    .method-grid {
      grid-template-columns: minmax(20rem, 0.85fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 6vw, 6rem);
      align-items: center;
    }
  }
</style>
