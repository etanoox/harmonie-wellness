---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';

const details = [
  { icon: 'clock', title: 'Durata', text: site.lesson.duration },
  { icon: 'calendar', title: 'Prenotazione', text: site.lesson.booking },
  { icon: 'user', title: 'Partecipazione', text: site.lesson.membership },
  { icon: 'spark', title: 'Cosa portare', text: site.lesson.clothing },
] as const;
---

<section id="lezioni" class="section lessons" aria-labelledby="lessons-title">
  <div class="container">
    <SectionHeading
      eyebrow="Le lezioni"
      title="Poche indicazioni, prima di iniziare."
      intro="La partecipazione è semplice, ma richiede prenotazione: in questo modo ogni appuntamento può essere organizzato con la giusta attenzione."
      align="center"
      headingId="lessons-title"
    />

    <div class="lesson-grid">
      {details.map((detail) => (
        <article class="lesson-card card">
          <div class="lesson-icon"><Icon name={detail.icon} /></div>
          <h3>{detail.title}</h3>
          <p>{detail.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .lesson-grid {
    display: grid;
    gap: 1rem;
  }

  .lesson-card {
    padding: var(--space-5);
  }

  .lesson-icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    margin-bottom: var(--space-4);
    color: var(--color-sage-900);
    background: var(--color-sage-200);
    border-radius: 50%;
  }

  .lesson-card h3 {
    margin-bottom: 0.6rem;
    font-size: var(--step-2);
  }

  .lesson-card p {
    margin: 0;
  }

  @media (min-width: 38rem) {
    .lesson-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .lesson-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
