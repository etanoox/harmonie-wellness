---
import { Picture } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';
import chiaraImage from '../assets/images/chiara-manno.webp';
---

<section id="harmonie" class="section about" aria-labelledby="about-title">
  <div class="container about-grid">
    <div class="about-visual">
      <div class="about-image">
        <Picture
          src={chiaraImage}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[420, 650, 756]}
          sizes="(max-width: 767px) calc(100vw - 2rem), 42vw"
          alt="Chiara Manno durante un esercizio di Pilates in equilibrio sulla spiaggia"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="about-caption">
        <strong>{site.professional.name}</strong>
        <span>{site.professional.role}</span>
      </div>
    </div>

    <div class="about-copy">
      <SectionHeading eyebrow="Chi siamo" title="Uno spazio nato per prendersi cura di sé." headingId="about-title" />
      <p>
        Sono Chiara Manno e ho creato Harmonie per chi desidera ritrovare uno spazio dedicato al proprio
        benessere, in un ambiente professionale, attento e accogliente.
      </p>
      <p>
        Al centro c’è la connessione tra benessere fisico e mentale: ogni lezione invita a muoversi con
        consapevolezza, ascoltare il corpo e mantenere la mente presente.
      </p>
      <div class="name-note">
        <span>Harmonie</span>
        <p>
          In francese significa “armonia”: una combinazione equilibrata, senza contrasti, capace di evocare
          bellezza e pace interiore.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .about-visual {
    position: relative;
    width: min(100%, 32rem);
    padding: 0 0 2.8rem 1rem;
    justify-self: center;
  }

  .about-image {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: 10rem 10rem var(--radius-lg) var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }

  .about-image :global(picture),
  .about-image :global(img) {
    width: 100%;
    height: 100%;
  }

  .about-image :global(img) {
    object-fit: cover;
  }

  .about-caption {
    position: absolute;
    right: -0.3rem;
    bottom: 0;
    display: grid;
    width: min(17rem, 75%);
    padding: 1rem 1.15rem;
    background: var(--color-white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  .about-caption strong {
    font-family: var(--font-display);
    font-size: 1.3rem;
  }

  .about-caption span {
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .about-copy > p {
    max-width: 41rem;
    font-size: var(--step-1);
  }

  .name-note {
    display: grid;
    gap: 0.65rem;
    max-width: 42rem;
    padding: var(--space-5);
    border-left: 3px solid var(--color-sage-500);
    margin-top: var(--space-5);
    background: var(--color-sage-50);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .name-note > span {
    color: var(--color-sage-800);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
  }

  .name-note p {
    margin: 0;
  }

  @media (min-width: 52rem) {
    .about-grid {
      grid-template-columns: minmax(18rem, 0.78fr) minmax(0, 1fr);
      gap: clamp(4rem, 8vw, 8rem);
    }
  }
</style>
