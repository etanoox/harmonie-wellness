---
interface Props {
  name: 'arrow' | 'calendar' | 'clock' | 'mail' | 'map' | 'menu' | 'phone' | 'spark' | 'user' | 'whatsapp' | 'x';
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'arrow' && <><path d="M5 12h14"/><path d="m14 7 5 5-5 5"/></>}
  {name === 'calendar' && <><path d="M6 2v4M18 2v4M3 9h18"/><rect x="3" y="4" width="18" height="18" rx="2"/></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></>}
  {name === 'map' && <><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3Z"/><path d="M9 3v15M15 6v15"/></>}
  {name === 'menu' && <><path d="M4 7h16M4 12h16M4 17h16"/></>}
  {name === 'phone' && <><path d="M6,3H4v5"/><path d="M4,8c2,7,5,10,12,12"/><path d="M16,20h5v-5"/></>}
  {name === 'spark' && <><path d="m12 3 1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5Z"/><path d="m19 15 .8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8Z"/></>}
  {name === 'user' && <><circle cx="12" cy="8" r="4"/><path d="M4 22a8 8 0 0 1 16 0"/></>}
  {name === 'whatsapp' && <><path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z"/><path d="M8.5 8.5c.5 3 2 4.5 5 5"/></>}
  {name === 'x' && <><path d="m6 6 12 12M18 6 6 18"/></>}
</svg>
